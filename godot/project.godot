; Godot project settings. Edit through Project > Project Settings
; in the editor; this file is plain text so it diffs cleanly.

config_version=5

[application]

config/name="Space Lord"
config/description="Stylized 3D space strategy: fly the system, build ships, mine, salvage and fight."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameClock="*res://scripts/autoload/game_clock.gd"
UiSkin="*res://scripts/autoload/ui_skin.gd"
Display="*res://scripts/autoload/display.gd"
Graphics="*res://scripts/autoload/graphics.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

anti_aliasing/quality/msaa_3d=2
